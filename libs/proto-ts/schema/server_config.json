{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/notbbg/notbbg/server/internal/config/server-config",
  "$ref": "#/$defs/ServerConfig",
  "$defs": {
    "ServerConfig": {
      "properties": {
        "unix_socket": {
          "type": "string"
        },
        "tcp_addr": {
          "type": "string"
        },
        "enable_tcp": {
          "type": "boolean"
        },
        "http_addr": {
          "type": "string"
        },
        "enable_http": {
          "type": "boolean"
        }
      },
      "type": "object",
      "required": [
        "unix_socket",
        "tcp_addr",
        "enable_tcp",
        "http_addr",
        "enable_http"
      ]
    }
  }
}
